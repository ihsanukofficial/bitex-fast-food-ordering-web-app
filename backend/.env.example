# Leave unset in local dev to auto-start an in-memory MongoDB (data resets on restart).
# Set to a real MongoDB (local or Atlas) connection string for persistent data.
MONGODB_URI=

PORT=5000

# Number of clustered worker processes to run (one per CPU core if unset). Only takes
# effect when MONGODB_URI is set — the zero-config in-memory database always runs as
# a single process, since multiple workers would each get their own private copy of it.
# WEB_CONCURRENCY=4

# Redis connection, used for the Socket.IO cross-worker adapter (only when clustered —
# see WEB_CONCURRENCY) and for caching the product catalog response. Leave at the
# default for local dev with a local Redis (or Redis-compatible) server running.
REDIS_URL=redis://127.0.0.1:6379

# Origin of the Vite dev server / deployed frontend, for CORS with credentials.
CLIENT_ORIGIN=http://localhost:5173

# Long, random secret used to sign auth JWTs.
JWT_SECRET=change-this-to-a-long-random-string

# Seeded admin account created by `npm run seed`.
SEED_ADMIN_NAME=BiteX Admin
SEED_ADMIN_EMAIL=admin@bitex.com
SEED_ADMIN_PASSWORD=change-this-password
